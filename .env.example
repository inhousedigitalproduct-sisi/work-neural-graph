WNG_DB_PATH=data/work_neural_graph.db
WNG_LOG_LEVEL=INFO
WNG_LLM_CONFIG=config/llm.conf

# Secret value must be provided only in the local/server environment.
OPENAI_API_KEY=

# Optional provider-profile overrides.
# OPENAI_MODEL=gpt-5-mini
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_HOST=http://localhost:11434
# LLM_TIMEOUT_SECONDS=180

# Optional override for the initial/default provider only.
# Normal switching between OpenAI / Qwen Local / Off is done in the Streamlit UI.
# LLM_PROVIDER=openai

# Optional embedding override.
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
